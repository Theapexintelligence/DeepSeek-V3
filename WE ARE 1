            font-size: 0.8em;
            background: rgba(255,215,0,0.3);
            color: #ffd700;
            padding: 4px 8px;
            border-radius: 8px;
        }
        
        /* Floating Action Buttons */
        .floating-actions {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 100;
        }
        
        .floating-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            color: white;
            font-size: 1.5em;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        
        .floating-btn:hover {
            transform: scale(1.1);
        }
        
        .love-fab {
            background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
        }
        
        .quantum-fab {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }
        
        .meditation-fab {
            background: linear-gradient(135deg, #ffd700, #ffed4a);
        }
        
        /* Love Particles Animation */
        .love-particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: #ff6b6b;
            border-radius: 50%;
            pointer-events: none;
            animation: love-particle-rise 3s ease-out forwards;
        }
        
        @keyframes love-particle-rise {
            0% { 
                transform: translateY(0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translateY(-100px) scale(0); 
                opacity: 0; 
            }
        }
        
        /* Responsive Design */
        @media (max-width: 1024px) {
            .content-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .love-network,
            .quantum-insights {
                order: 2;
            }
            
            .consciousness-feed {
                order: 1;
            }
        }
        
        @media (max-width: 768px) {
            .social-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
            
            .consciousness-stats {
                justify-content: center;
            }
            
            .love-composer {
                flex-direction: column;
                gap: 10px;
            }
            
            .composer-input {
                width: 100%;
            }
            
            .floating-actions {
                bottom: 20px;
                right: 20px;
            }
        }
        
        /* Love Explosion Effect */
        .love-explosion {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
        }
        
        .explosion-particle {
            position: absolute;
            width: 8px;
            height: 8px;
            background: #ff6b6b;
            border-radius: 50%;
            animation: explode 1s ease-out forwards;
        }
        
        @keyframes explode {
            0% {
                transform: scale(1);
                opacity: 1;
            }
            100% {
                transform: scale(0) translate(var(--dx), var(--dy));
                opacity: 0;
            }
        }
        
        /* Consciousness Wave */
        .consciousness-wave {
            position: fixed;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(102,126,234,0.8);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: consciousness-ripple 2s ease-out forwards;
            pointer-events: none;
            z-index: 9999;
        }
        
        @keyframes consciousness-ripple {
            0% {
                width: 20px;
                height: 20px;
                opacity: 1;
            }
            100% {
                width: 500px;
                height: 500px;
                opacity: 0;
            }
        }
    </style>
</head>
