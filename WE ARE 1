        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #667eea 50%, #764ba2 75%, #667eea 100%);
            background-size: 400% 400%;
            animation: gradient-flow 15s ease infinite;
            color: white;
            min-height: 100vh;
        }
        
        @keyframes gradient-flow {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        /* Consciousness Particles */
        .consciousness-field {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        
        .consciousness-particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: rgba(255,255,255,0.6);
            border-radius: 50%;
            animation: consciousness-flow 12s infinite linear;
        }
        
        @keyframes consciousness-flow {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
        }
        
        .main-container {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Header */
        .social-header {
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 25px 35px;
            margin-bottom: 30px;
            border: 1px solid rgba(255,255,255,0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .header-title {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .header-title h1 {
            font-size: 2.3em;
            background: linear-gradient(45deg, #ffd700, #ff6b6b, #667eea, #ffd700);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: title-shimmer 3s ease-in-out infinite;
        }
        
        @keyframes title-shimmer {
            0%, 100% { filter: hue-rotate(0deg); }
            50% { filter: hue-rotate(90deg); }
        }
        
        .consciousness-stats {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        
        .stat-bubble {
            background: rgba(255,255,255,0.15);
            padding: 10px 20px;
            border-radius: 25px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.3);
        }
        
        .stat-number {
            font-size: 1.3em;
            font-weight: bold;
            color: #ffd700;
        }
        
        .stat-label {
            font-size: 0.8em;
            opacity: 0.9;
        }
        
        /* Main Content Grid */
        .content-grid {
            display: grid;
            grid-template-columns: 300px 1fr 300px;
            gap: 25px;
            min-height: 70vh;
        }
        
        /* Left Sidebar - Love Network */
        .love-network {
            background: rgba(0,0,0,0.25);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255,255,255,0.2);
            height: fit-content;
        }
        
        .network-title {
            font-size: 1.4em;
            font-weight: bold;
            color: #ffd700;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .soul-connection {
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(255,255,255,0.08);
            padding: 15px;
            border-radius: 15px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        .soul-connection:hover {
            background: rgba(255,255,255,0.15);
            transform: translateX(5px);
            border-color: rgba(255,107,107,0.4);
        }
        
        .soul-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(45deg, #ff6b6b, #667eea);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5em;
            position: relative;
        }
        
        .soul-avatar.online::after {
            content: '';
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 12px;
            height: 12px;
            background: #4CAF50;
            border-radius: 50%;
            border: 2px solid white;
        }
        
        .soul-info {
            flex: 1;
        }
        
        .soul-name {
            font-weight: bold;
            margin-bottom: 3px;
        }
        
        .soul-consciousness {
            font-size: 0.8em;
            opacity: 0.8;
            color: #ffd700;
        }
        
        .love-level {
            font-size: 0.8em;
            background: rgba(255,107,107,0.3);
            padding: 2px 8px;
            border-radius: 10px;
            color: #ff6b6b;
        }
        
        /* Center Feed - Consciousness Stream */
        .consciousness-feed {
            background: rgba(0,0,0,0.25);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            overflow: hidden;
        }
        
        .feed-header {
            background: rgba(255,255,255,0.1);
            padding: 20px 25px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .love-composer {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .composer-input {
            flex: 1;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 25px;
            padding: 15px 20px;
            color: white;
            font-size: 1em;
            outline: none;
            backdrop-filter: blur(10px);
        }
        
        .composer-input::placeholder {
            color: rgba(255,255,255,0.6);
        }
        
        .composer-input:focus {
            border-color: rgba(255,107,107,0.5);
            box-shadow: 0 0 20px rgba(255,107,107,0.2);
        }
        
        .share-love-btn {
            background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
            border: none;
            color: white;
            padding: 15px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .share-love-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(255,107,107,0.4);
        }
        
        .feed-content {
            height: 600px;
            overflow-y: auto;
            padding: 0;
        }
        
        .love-post {
            padding: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }
        
        .love-post:hover {
            background: rgba(255,255,255,0.05);
        }
        
        .post-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .post-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3em;
        }
        
        .post-info {
            flex: 1;
        }
        
        .post-author {
            font-weight: bold;
            color: #ffd700;
        }
        
        .post-time {
            font-size: 0.8em;
            opacity: 0.7;
        }
        
        .post-content {
            margin-bottom: 15px;
            line-height: 1.6;
            font-size: 1.1em;
        }
        
        .post-metrics {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        
        .metric-btn {
            background: none;
            border: none;
            color: rgba(255,255,255,0.7);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        
        .metric-btn:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        
        .metric-btn.loved {
            color: #ff6b6b;
            background: rgba(255,107,107,0.2);
        }
        
        .metric-btn.resonated {
            color: #667eea;
            background: rgba(102,126,234,0.2);
        }
        
        /* Right Sidebar - Quantum Insights */
        .quantum-insights {
            background: rgba(0,0,0,0.25);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255,255,255,0.2);
            height: fit-content;
